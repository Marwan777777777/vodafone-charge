# Copy to .env for local development. Never commit real secrets.

# --- API (Railway) ---
PORT=4000
NODE_ENV=development
DATABASE_URL=postgres://charge:charge@localhost:5432/charge
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
GARAGE_API_KEY=replace-with-the-hardware-system-api-key
CORS_ORIGIN=http://localhost:5173
TZ_NAME=Africa/Cairo
HARDWARE_MODE=sim
SEED_PASSWORD=Charge#22

# --- Web (Vercel) ---
# Set this at build time on Vercel. Locally leave empty to use the Vite proxy.
VITE_API_URL=http://localhost:4000
